import wollok.game.*
import gatoSalvito.*
import elementos.*
import visualesPantalla.*
import gestores.*

object logicaJuego {
    var partidaIniciada = false

    method arrancar() {
        game.addVisual(pantallaDeTitulo)
        keyboard.enter().onPressDo({
            if (!partidaIniciada) {
                partidaIniciada = true
                game.removeVisual(pantallaDeTitulo)
                self.iniciarPartida()
            }
        })
    }

    method iniciarPartida() {
        // 1. El fondo se agrega primero para quedar en la capa inferior.
        game.addVisual(fondo)
        game.addVisual(iconoPecera)
        game.addVisual(medidorOxigeno)
        game.addVisual(salvito)

        // 2. Inicia el nivel 1 y activa el ciclo de oxígeno.
        gestorDeNivel.iniciarJuego()

        // 3. Controles de movimiento y tecla R para reintentar al perder/ganar.
        keyboard.up().onPressDo({ salvito.intentarMover({ salvito.moverArriba() }) })
        keyboard.down().onPressDo({ salvito.intentarMover({ salvito.moverAbajo() }) })
        keyboard.left().onPressDo({ salvito.intentarMover({ salvito.moverIzquierda() }) })
        keyboard.right().onPressDo({ salvito.intentarMover({ salvito.moverDerecha() }) })
        keyboard.r().onPressDo({ gestorDeNivel.intentarReiniciar() })

        // 4. Polimorfismo en colisiones con cualquier elemento del tablero.
        game.onCollideDo(salvito, { elemento => elemento.afectarA(salvito) })
    }
}

program michinautaGame {
    game.title("El Michinauta")
    game.width(16)
    game.height(10)
    game.cellSize(50)

    logicaJuego.arrancar()
    
    game.start()
}