import wollok.game.*
import gatoSalvito.*
import elementos.*
import visualesPantalla.*
import gestores.*

object logicaJuego {
    method arrancar() {
        game.addVisual(pantallaDeTitulo)
        keyboard.enter().onPressDo({
            game.removeVisual(pantallaDeTitulo)
            self.iniciarPartida()
        })
    }

    method iniciarPartida() {
        game.addVisual(iconoPecera)
        game.addVisual(medidorOxigeno)
        game.addVisual(salvito)

        gestorDeNivel.iniciarJuego()

        // Delegamos el movimiento y cambio de sprite en Salvito.
        keyboard.up().onPressDo({ salvito.moverArriba() })
        keyboard.down().onPressDo({ salvito.moverAbajo() })
        keyboard.left().onPressDo({ salvito.moverIzquierda() })
        keyboard.right().onPressDo({ salvito.moverDerecha() })

        // Polimorfismo en colisiones con cualquier elemento del tablero.
        game.onCollideDo(salvito, { elemento => elemento.afectarA(salvito) })

        // Delegación total del ciclo de oxígeno en Salvito.
        game.onTick(1000, "cicloDeOxigeno", {
            salvito.asimilarAmbiente()
        })
    }
}

program michinautaGame {
    game.title("El Michinauta")
    game.width(16)
    game.height(10)
    game.cellSize(50)

    logicaJuego.arrancar()
    
    game.start()
}