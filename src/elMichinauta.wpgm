import wollok.game.*
import gatoSalvito.*
import elementos.*
import visualesPantalla.*
import gestores.*

object logicaJuego {
    const imagenesSecuenciaIntro = [
        "intro_negro.png",
        "intro_nevada.png",
        "intro_huellas.png",
        "titulo.png",
        "instrucciones.png"
    ]
    var etapaIntro = 0
    var partidaIniciada = false

    method arrancar() {
        pantallaIntro.image(imagenesSecuenciaIntro.get(etapaIntro))
        game.addVisual(pantallaIntro)

        // Tanto X como ENTER sirven para avanzar en la intro y en las pantallas de diálogo/transición
        keyboard.enter().onPressDo({ self.procesarAvance() })
        keyboard.x().onPressDo({ self.procesarAvance() })
    }

    method procesarAvance() {
        if (!partidaIniciada) {
            self.avanzarIntro()
        } else {
            gestorDeNivel.continuarConX()
        }
    }

    method avanzarIntro() {
        // Al pasar de la pantalla negra inicial (etapa 0) a la primera imagen, arranca la música en loop
        if (etapaIntro == 0) {
            gestorMusica.iniciarMusicaIntro()
        }

        etapaIntro += 1

        if (etapaIntro < imagenesSecuenciaIntro.size()) {
            pantallaIntro.image(imagenesSecuenciaIntro.get(etapaIntro))
        } else {
            partidaIniciada = true
            game.removeVisual(pantallaIntro)
            self.iniciarPartida()
        }
    }

    method iniciarPartida() {
        // 1. Fondo y barras de estado gráficas
        game.addVisual(fondo)
        game.addVisual(salvito)
        game.addVisual(barraOxigeno)
        game.addVisual(barraVelocidad)

        // 2. Inicia el nivel 1, corta la música de intro y arranca la música de nevada en loop
        gestorDeNivel.iniciarJuego()

        // 3. Controles de movimiento, R para reiniciar nivel y V para volver a empezar
        keyboard.up().onPressDo({ salvito.intentarMover({ salvito.moverArriba() }) })
        keyboard.down().onPressDo({ salvito.intentarMover({ salvito.moverAbajo() }) })
        keyboard.left().onPressDo({ salvito.intentarMover({ salvito.moverIzquierda() }) })
        keyboard.right().onPressDo({ salvito.intentarMover({ salvito.moverDerecha() }) })
        keyboard.r().onPressDo({ gestorDeNivel.intentarReiniciarNivel() })
        keyboard.v().onPressDo({ gestorDeNivel.intentarVolverAEmpezar() })

        // 4. Polimorfismo en colisiones con cualquier elemento del tablero
        game.onCollideDo(salvito, { elemento => elemento.afectarA(salvito) })
    }
}

program michinautaGame {
    game.title("El Michinauta")
    game.width(16)
    game.height(10)
    game.cellSize(80)

    logicaJuego.arrancar()
    
    game.start()
}